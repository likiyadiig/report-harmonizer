generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  queued
  processing
  done
  failed
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("") // required by Better Auth, unused
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ruleSet  RuleSet?
  jobs     Job[]
  sessions Session[]
  accounts Account[]
}

model RuleSet {
  id        String   @id @default(cuid())
  userId    String   @unique
  body      String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id               String    @id @default(cuid())
  userId           String
  status           JobStatus @default(queued)
  originalFilename String? // cleared when files are deleted
  rulesSnapshot    String // copy of RuleSet.body when the job started
  model            String
  promptVersion    String

  paragraphsTotal Int? // unknown until the file is read
  paragraphsDone  Int     @default(0)
  editsTotal      Int     @default(0)
  editsFlagged    Int     @default(0)
  editsSkipped    Int     @default(0)
  inputTokens     Int     @default(0)
  outputTokens    Int     @default(0)
  error           String? // short reason, never report text

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finishedAt     DateTime?
  downloadedAt   DateTime?
  filesDeletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Sign-in tables required by Better Auth.

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
