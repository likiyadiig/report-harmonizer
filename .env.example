DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Absolute path outside the project folder where uploaded reports are stored.
UPLOAD_DIR=
# Resend API key. In development, use a separate dev key, never the
# production one. Leave empty to print sign-in links to the terminal.
EMAIL_API_KEY=
# Sender, in the form: Report Harmonizer <signin@yourdomain.com>
EMAIL_FROM=
# Who can sign in: email addresses separated by commas. Case and spaces
# are ignored. Required in production. In development, leave empty to let
# any address sign in.
ALLOWED_EMAILS=
